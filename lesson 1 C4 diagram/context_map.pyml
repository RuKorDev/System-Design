@startuml
!define RECTANGLE class

skinparam rectangle<<Bounded Context>> {
  BackgroundColor #White
  BorderColor #Black
  FontSize 13
}

rectangle "Customer Context(CC)" as CC <<Клиент>>
rectangle "Wallet Context(WC)" as WC <<Кошельки/счета>>
rectangle "Payments Initiator Context(PIC)" as PIC <<Инициация платежа>>
rectangle "Anti-Fraud Context(AFC)" as AFC <<Проверка на антифрод>>
rectangle "Payment Executor Context(PEC)" as PEC <<Исполнитель платежа>>
rectangle "Payment History Context(PHC)" as PHC <<История платежей>>
rectangle "Core Banking Context(CBC)" as CBC <<Legacy>>
rectangle "Card Processing(CP)" as CP
rectangle "Anti-Corruption Layer(ACL)" as ACL
rectangle "Notifications Context(NC)" as NC <<Оповещения>>

CC --> PIC : "Income payment(OHS PIC - upstream, CC - downstream )"

PIC --> WC : "Reserves(OHS, WC - upstream,PIC - downstream) "
PIC --> AFC : "Checks transaction(PIC - supplier, AFC- customer)"
PIC --> PEC : "Approval(Published Language PIC - downstream, PEC - upstream")
AFC --> PEC : "Approval/Reject(Published Language AFC - downstream, PEC - upstream")"
PEC --> ACL : "Sends payment order(Published Language ACL - downstream, PEC - upstream")"
ACL --> CBC : "Executes payment(OHS CBC - upstream, ACL - downstream)"
ACL --> CP : "Executes payment (OHS CP - upstream, ACL - downstream)"
PEC --> PHC : "Logs result (Published Language, PEC - upstream, PHC -downstream)"
PEC --> WC : "Updates balance (Published Language, PEC - upstream, WC -downstream)"
PEC --> NC : "Sends receipt (Published Language, PEC - upstream, NC -downstream)"

@enduml